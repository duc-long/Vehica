# ------------------------------------------------------------------------------
# 1. ENVIRONMENT VARIABLES & SENSITIVE SECRETS
# ------------------------------------------------------------------------------
.env
.env.local
.env.*.local
*.env
backend/.env
mobile/.env

# Keystores, certificates & keys
*.jks
*.keystore
*.p12
*.pem
*.key
google-services.json
GoogleService-Info.plist

# ------------------------------------------------------------------------------
# 2. BACKEND (JAVA / SPRING BOOT / MAVEN)
# ------------------------------------------------------------------------------
backend/target/
**/target/
*.class
*.sql
# Package files
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# Maven wrapper jar exclusion (keep wrapper functional)
!.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/

# Local embedded database files
*.db
*.h2.db
backend/*.mv.db
backend/*.trace.db

